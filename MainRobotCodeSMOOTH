M5UnitJoystick2 joystick;
M5_UNIT_8SERVO walk_bot;

#define R_foot 0
#define R_knee 1
#define R_hip  2
#define L_foot 3
#define L_knee 4
#define L_hip  5

int currentAngles[6] = {93, 95, 90, 90, 90, 90}; // R_foot, R_knee, R_hip, L_foot, L_knee, L_hip


void SmoothMoveAll(int stepDelay_ms,
                   int t_R_foot, int t_R_knee, int t_R_hip,
                   int t_L_foot, int t_L_knee, int t_L_hip) {

    int targets[6] = {t_R_foot, t_R_knee, t_R_hip, t_L_foot, t_L_knee, t_L_hip};
    bool done = false;

    while (!done) {
        done = true;
        for (int i = 0; i < 6; i++) {
            if (currentAngles[i] != targets[i]) {
                currentAngles[i] += (targets[i] > currentAngles[i]) ? 1 : -1;
                walk_bot.setServoAngle(i, currentAngles[i]);
                done = false;
            }
        }
        delay(stepDelay_ms);
    }
}


void displayCurrent() {
    float current = walk_bot.getServoCurrent();
    int battery = M5.Power.getBatteryLevel();
    M5.Lcd.fillScreen(BLACK);
    M5.Lcd.setCursor(0, 0);
    M5.Lcd.setTextSize(2);
    M5.Lcd.print("I: ");
    M5.Lcd.print(current);
    M5.Lcd.println("A");
    M5.Lcd.print("Bat: ");
    M5.Lcd.print(battery);
    M5.Lcd.println("%");
}


void NeutralStance() {
    SmoothMoveAll(10, 93, 95, 90, 90, 90, 90);
}

void squat() {
    SmoothMoveAll(20, 130, 10, 20, 50, 170, 160);
}


