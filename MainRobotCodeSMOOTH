void setup() {
    M5.begin();
    walk_bot.begin(&Wire, 9, 10, M5_UNIT_8SERVO_DEFAULT_ADDR);
    joystick.begin(&Wire, JOYSTICK2_ADDR, 9, 10);
    walk_bot.setAllPinMode(SERVO_CTL_MODE);
    delay(2000);
    NeutralStance();
}

void loop() {
    M5.update();

  displayCurrent(); 
  
