void SmoothMove(uint8_t channel, uint8_t startAngle, uint8_t endAngle, int stepDelay) { // define all inputs in function: channel, start angle, end angle, ms elapsed 
  if (startAngle < endAngle) { // if starting angle less than end angle (so 90 to 120 movement i.e)
    for (int angle = startAngle; angle <= endAngle; angle++) { // increment the angle until it reaches end angle 
      walk_bot.setServoAngle(channel, angle); // incremently changes the angle of the servo 
      delay(stepDelay); // delays it by ms elapsed
    }
  } else {
    for (int angle = startAngle; angle >= endAngle; angle--) { // same logic applied but for higher to lower angle logic 
      walk_bot.setServoAngle(channel, angle);
      delay(stepDelay);
    }
  }
}

