M5_UNIT_8SERVO walk_bot;    

#define R_foot 0  // right foot servo channel
#define R_knee 1   // right knee servo channel
#define R_hip  2   // right hip servo channel

#define L_foot  3   // left foot servo channel
#define L_knee  4   // left knee servo channel
#define L_hip  5  // left hip servo channel

void displayCurrent() {
  float current = walk_bot.getServoCurrent();
  M5.Lcd.fillScreen(BLACK);
  M5.Lcd.setCursor(0, 0);
  M5.Lcd.setTextSize(2);
  M5.Lcd.print("Current:");
  M5.Lcd.print(current);
  M5.Lcd.println(" A");
}

void standStill()
{

  walk_bot.setServoAngle(R_foot, 90);
  walk_bot.setServoAngle(R_knee, 90);
  walk_bot.setServoAngle(R_hip, 90);
  walk_bot.setServoAngle(L_foot, 90);
  walk_bot.setServoAngle(L_knee, 90);
  walk_bot.setServoAngle(L_hip, 90);

}

